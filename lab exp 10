import pandas as pd
import matplotlib.pyplot as plt
sales_data = pd.read_csv("monthly_sales.csv")
print("Monthly Sales Data")
print(sales_data)
plt.figure(figsize=(8,5))
plt.plot(sales_data["Month"], sales_data["Sales"], marker='o')
plt.title("Monthly Sales Data")
plt.xlabel("Month")
plt.ylabel("Sales")
plt.grid(True)
plt.show()
