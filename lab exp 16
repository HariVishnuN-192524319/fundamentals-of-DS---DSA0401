import pandas as pd
import numpy as np
data = pd.read_csv("stock_data.csv")
print("Stock Data:")
print(data)
closing_prices = data["Close"]
mean_price = np.mean(closing_prices)
variance = np.var(closing_prices)
std_dev = np.std(closing_prices)
print("\n----- Stock Price Analysis -----")
print("Mean Closing Price:", mean_price)
print("Variance:", variance)
print("Standard Deviation:", std_dev)
print("\nInsights:")
if std_dev > 20:
    print("The stock prices show HIGH variability (more risk).")
else:
    print("The stock prices show LOW variability (more stable).")
