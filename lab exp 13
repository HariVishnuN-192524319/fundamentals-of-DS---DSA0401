import pandas as pd

# Read the CSV file
stock_data = pd.read_csv("stock_prices.csv")

# Display the dataset
print("Stock Price Data")
print(stock_data)

# Calculate statistical measures
mean_price = stock_data["Closing_Price"].mean()
max_price = stock_data["Closing_Price"].max()
min_price = stock_data["Closing_Price"].min()
std_dev = stock_data["Closing_Price"].std()
variance = stock_data["Closing_Price"].var()

# Display results
print("\nStock Price Analysis")
print("Average Closing Price :", mean_price)
print("Maximum Closing Price :", max_price)
print("Minimum Closing Price :", min_price)
print("Standard Deviation    :", std_dev)
print("Variance              :", variance)
