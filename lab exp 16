import pandas as pd
data = pd.read_csv("sample_text.csv")
text = " ".join(data["Text"].astype(str)).lower()
for ch in ".,!?;:":
    text = text.replace(ch, "")
words = text.split()
frequency = {}
for word in words:
    if word in frequency:
        frequency[word] += 1
    else:
        frequency[word] = 1
print("Frequency Distribution of Words:")
for word, count in frequency.items():
    print(word, ":", count)
