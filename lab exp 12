import pandas as pd
import matplotlib.pyplot as plt
weather_data = pd.read_csv("weather_data.csv")
print("Monthly Temperature and Rainfall Data")
print(weather_data)
plt.figure(figsize=(8,5))
plt.plot(weather_data["Month"], weather_data["Temperature"], marker='o')
plt.title("Monthly Temperature")
plt.xlabel("Month")
plt.ylabel("Temperature (°C)")
plt.grid(True)
plt.show()
plt.figure(figsize=(8,5))
plt.scatter(weather_data["Month"], weather_data["Rainfall"])
plt.title("Monthly Rainfall")
plt.xlabel("Month")
plt.ylabel("Rainfall (mm)")
plt.grid(True)
plt.show()
